<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryAPI.Domain\InventoryAPI.Domain.csproj" />
    <ProjectReference Include="..\InventoryAPI.Application\InventoryAPI.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\InventoryAPI\Data\**\*.cs">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Infrastructure\**\*.cs">
      <Link>Infrastructure\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Include only infrastructure helpers; keep Web-only helpers (SwaggerExtensions) in the Web project -->
    <Compile Include="..\InventoryAPI\Helpers\JwtHelper.cs">
      <Link>Helpers\JwtHelper.cs</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Helpers\Queries.cs">
      <Link>Helpers\Queries.cs</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Helpers\CommonMethods.cs">
      <Link>Helpers\CommonMethods.cs</Link>
    </Compile>
    <!-- Include service implementations moved from the Web project into Infrastructure -->
    <Compile Include="..\InventoryAPI.Service\**\*.cs">
      <Link>Services\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Services\**\*.cs">
      <Link>Services\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- Repository implementations only; interfaces are owned by Application layer -->
    <Compile Include="..\InventoryAPI\Repositories\ProductRepo.cs">
      <Link>Repositories\ProductRepo.cs</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Repositories\SupplierRepository.cs">
      <Link>Repositories\SupplierRepository.cs</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Repositories\UserRepo.cs">
      <Link>Repositories\UserRepo.cs</Link>
    </Compile>
    <Compile Include="..\InventoryAPI\Repositories\CategoryRepository.cs">
      <Link>Repositories\CategoryRepository.cs</Link>
    </Compile>
    <EmbeddedResource Include="..\InventoryAPI\Sql\**\*.sql">
      <Link>Sql\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Infrastructure package dependencies -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\InventoryAPI\EntityConfigurations\**\*.cs">
      <Link>EntityConfigurations\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
