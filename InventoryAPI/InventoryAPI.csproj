<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="6.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.21.0" />
    <PackageReference Include="FluentValidation" Version="11.3.1" />
    <PackageReference Include="MediatR" Version="11.1.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryAPI.Domain\InventoryAPI.Domain.csproj" />
    <ProjectReference Include="..\InventoryAPI.Application\InventoryAPI.Application.csproj" />
    <ProjectReference Include="..\InventoryAPI.Infrastructure\InventoryAPI.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
    <!-- Keep SwaggerExtensions in Web project for AddSwaggerGen usage -->
    <!-- SwaggerExtensions removed; keep Swagger wiring in Web via Swashbuckle package references and Program.cs -->
  </ItemGroup>
  <!-- Exclude sources moved to class libraries (linked into their owning projects) -->
  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Exceptions\**\*.cs" />
    <Compile Remove="EntityModel\**\*.cs" />
    <Compile Remove="EntityConfigurations\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Features\**\*.cs" />
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Infrastructure\**\*.cs" />
    <Compile Remove="Repositories\**\*.cs" />
    <EmbeddedResource Remove="Sql\**\*.sql" />
  </ItemGroup>
  <!-- Exclude sources moved to class libraries (linked into their owning projects) -->
  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Exceptions\**\*.cs" />
    <Compile Remove="EntityModel\**\*.cs" />
    <Compile Remove="EntityConfigurations\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Features\**\*.cs" />
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Infrastructure\**\*.cs" />
    <Compile Remove="Repositories\**\*.cs" />
    <EmbeddedResource Remove="Sql\**\*.sql" />
  </ItemGroup>
</Project>
